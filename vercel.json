{
  "cleanUrls": false,
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/control", "destination": "/basketball-scoreboard.html" },
    { "source": "/display", "destination": "/scoreboard-display.html" },
    { "source": "/display2", "destination": "/scoreboard-display2.html" },
    { "source": "/shotclock", "destination": "/shotclock-control.html" },
    { "source": "/shotclock-display", "destination": "/shotclock-display.html" },
    { "source": "/overlay", "destination": "/basketball-fullscreen.html" },
    { "source": "/fullscreen", "destination": "/basketball-fullscreen.html" },
    { "source": "/nbaoverlay", "destination": "/basketball-nbaoverlay.html" },
    { "source": "/nbaoverlay2", "destination": "/basketball-nbaoverlay2.html" },
    { "source": "/nbc", "destination": "/basketball-nba-nbc.html" },
    { "source": "/scripps", "destination": "/basketball-scripps.html" },
    { "source": "/scripps-overlay", "destination": "/basketball-scripps.html" },
    { "source": "/overlay3", "destination": "/basketball-scripps.html" },
    { "source": "/pill", "destination": "/basketball-scripps.html" },
    { "source": "/frontcam", "destination": "/basketball-frontcam.html" },
    { "source": "/front-cam", "destination": "/basketball-frontcam.html" },
    { "source": "/cam1", "destination": "/basketball-frontcam.html?style=1" },
    { "source": "/cam2", "destination": "/basketball-frontcam.html?style=2" },
    { "source": "/cam3", "destination": "/basketball-frontcam.html?style=3" },
    { "source": "/cam4", "destination": "/basketball-frontcam.html?style=4" },
    { "source": "/cam5", "destination": "/basketball-frontcam.html?style=5" },
    { "source": "/camera", "destination": "/camera.html" }
  ]
}
